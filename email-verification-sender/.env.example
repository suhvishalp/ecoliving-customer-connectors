# Local development only. Deployed, the CTP_* values are injected by Connect from the API Client it
# generates from inheritAs.apiClient.scopes — nobody enters them.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_SCOPE=

# Where the verification link points. The link lands on the STOREFRONT, whose BFF confirms the token
# (course task 5.8) — the connector never confirms anything itself.
STOREFRONT_URL=http://localhost:3000
# Which link goes into the mail. `storefront` (the BFF track): the storefront page hands the token to
# the BFF, which confirms it. `connector` (the CIL track, no BFF): the link points at this connector's
# own receiver app (RECEIVER_URL), which confirms and redirects to the storefront.
VERIFY_LINK_MODE=storefront
RECEIVER_URL=
# How long a verification link stays valid. 4320 minutes = 3 days.
TOKEN_TTL_MINUTES=4320
# Backlog guard: unacknowledged messages live 7 days, so a handler broken over a weekend comes back to
# a stampede. Refuse to act on anything older than this.
MAX_MESSAGE_AGE_HOURS=72

# Local port. The BFF owns 8081 and the order connector 8090/8091, so this one sits beside them.
PORT=8092

LOG_LEVEL=info
