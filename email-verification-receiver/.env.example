# Local development only. Deployed, the CTP_* values are injected by Connect from the API Client it
# generates from inheritAs.apiClient.scopes — nobody enters them.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_SCOPE=

# Where the shopper lands after the click: `${STOREFRONT_URL}/verify-email?status=ok|invalid`.
STOREFRONT_URL=http://localhost:3000

# Local port. The BFF owns 8081 and the order connector 8090/8091, so this one sits beside them.
PORT=8094

LOG_LEVEL=info
