# ---------------------------------------------------------------------------------------------
# Local development only.
#
# DEPLOYED, the CTP_* values are NOT asked for: connect.yaml declares inheritAs.apiClient.scopes, so
# Connect generates a least-privilege API Client and injects these at runtime. Nobody pastes a
# manage_project secret into the install form, and nobody can. (Session 9.1.)
# ---------------------------------------------------------------------------------------------
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_SCOPE=

# The shared secret the platform presents on every Extension call. postDeploy registers the Extension
# with it; auth.middleware verifies it. Invent one per installation; it IS securedConfiguration.
EXTENSION_SECRET=change-me

# What a customer number looks like: EL-000042.
CUSTOMER_NUMBER_PREFIX=EL-

# Local port. The BFF owns 8081 and the order connector 8090/8091, so this one sits beside them.
PORT=8093

LOG_LEVEL=info
